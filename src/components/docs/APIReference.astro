---
// @ts-nocheck
import { Code } from "astro:components";
---

<main class="main-content">

    <h1>API Reference</h1>

    <p>
        Access insights from OnlyOneMessage through it's REST API, available since version 1.7.
        This is used for our frontend operations.
    </p>

    <p>
        You can access the API at <code>https://oom-api.monobyte.studio</code>.
    </p>

    <div class="hint-card hint">
        <div class="icon">💡</div>
        <p>
            This API is in <b>beta</b>; expect major changes as OnlyOneMessage updates.
            If you encounter a problem, create a ticket in our <a href="/support">support server</a>!
        </p>
    </div>

    <h2>/v1/stats <span class="chip red">GET</span></h2>
    <p>
        Retrieve general statistics about OnlyOneMessage. Data includes its version, message
        metrics, latency, and more.
    </p>

    <Code
        lang="http"
        code={`GET https://oom-api.monobyte.studio/v1/stats`}
    />

    <Code
        lang="js"
        code={`{
        "version": "2.0.0", // Major.Minor.Micro
        "build": "2026.4.15", // Year.Month.Day
        "latency": 32, // milliseconds
        "uptime": 5, // seconds
        "shards": 4,
        "guilds": 64,
        "members": 1337,
        "channels": 60,
        "whitelists": 500,
        "blacklists": 500,
        "totalmsgs": 1000
    }`}
    />

    <h2>/v1/health <span class="chip red">GET</span></h2>

    <p>
        Check the bot's online status and shard latencies.
    </p>

    <Code
        lang="http"
        code={`GET https://oom-api.monobyte.studio/v1/health`}
    />

    <Code
        lang="js"
        code={`{
        "database": "online", // "online" or "offline"
        "health": "online", // "online" or "degraded"

        "shards": {
            "0": { // for each shard ID
            "latency": 0, // displayed in seconds (ex: 0.4 = 400ms)
            "status": "online" // "online", "degraded", or "offline"
            "guilds": 16,
            "members": 400,
            "channels": 15
            }
        }
    }`}
    />

</main>