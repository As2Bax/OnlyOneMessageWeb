<section class="about">

    <section class="image-gallery">
        <div class="gallery-track">
            <!-- astro-ignore -->
            <img src="/img/carousel/img1.png" alt="" loading="lazy" decoding="async">
            <img src="/img/carousel/img2.png" alt="" loading="lazy" decoding="async">
            <img src="/img/carousel/img3.png" alt="" loading="lazy" decoding="async">
            <img src="/img/carousel/img4.png" alt="" loading="lazy" decoding="async">
        </div>
      </section>

    <p>
        OnlyOneMessage is a feature-rich Discord bot that provides server admins <span class="highlight">complete control</span> over text channel behavior.
        Set slowmodes <span class="highlight">surpassing Discord's limit</span>, log <span class="highlight">individual member cooldowns</span>,
        and <span class="highlight">fine-tune</span> settings for <span class="highlight">each individual channel</span>,
        all through a straightforward interface using Discord's slash commands.
    </p>

</section>



<script>
    // @ts-nocheck
    document.addEventListener("DOMContentLoaded", () => {
    const track = document.querySelector(".gallery-track");
    if (!track) return;

    const images = Array.from(track.children);

    Promise.all(
        images.map(img => img.complete
        ? Promise.resolve()
        : new Promise(res => { img.onload = res; img.onerror = res; })
        )
    ).then(() => {
        const gap = 30; // from the CSS
        const originalWidth = images.reduce((sum, img) => {
        return sum + img.getBoundingClientRect().width + gap;
        }, 0);

        images.forEach(img => track.appendChild(img.cloneNode(true)));

        let NormalSpeed = 1;
        let SlowSpeed = 0.5;
        let speed = NormalSpeed;
        let position = 0;
        let lastTime = null;

        function scrollGallery(timestamp) {
        if (lastTime !== null) {
            const delta = timestamp - lastTime;
            position -= speed * (delta / 16.67);
        }
        lastTime = timestamp;

        
        if (Math.abs(position) >= originalWidth) position += originalWidth;
        track.style.transform = `translateX(${position}px)`;
        requestAnimationFrame(scrollGallery);
        }

        requestAnimationFrame(scrollGallery);

        track.parentElement.addEventListener("mouseenter", () => speed = SlowSpeed);
        track.parentElement.addEventListener("mouseleave", () => speed = NormalSpeed);
    });
    });
</script>